# -----------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# -----------------------------------------------------------------------
# Virtual environments
# -----------------------------------------------------------------------
venv/
.venv/
env/
.env/

# -----------------------------------------------------------------------
# Environment variables / secrets
# -----------------------------------------------------------------------
.env
.env.*
*.env

# -----------------------------------------------------------------------
# Database files (SQLite — never commit live data)
# -----------------------------------------------------------------------
*.db
*.sqlite3

# -----------------------------------------------------------------------
# Generated data files (large, rebuilt by scrapers — never commit)
# -----------------------------------------------------------------------
data/*.csv.gz
data/_pfr_checkpoints/

# -----------------------------------------------------------------------
# Database backups. Full dumps (scrapers/db_backup.py) stay OUT of git:
# the users table holds password hashes.
#
# The three exports from `flask export-critical-data` are the exception,
# changed deliberately on 2026-09-22 when the Render database (the second
# copy of this data) was cancelled. lineups/prop_bets/prop_picks are the
# only tables no scraper can rebuild, they carry no credentials, and the
# repo is private — so weekly_after.bat commits them and GitHub becomes
# the copy that survives this machine. It is still participants' own
# submitted data: if this repo ever goes public, drop these lines.
backups/*
!backups/lineups_*.csv
!backups/prop_bets_*.csv
!backups/prop_picks_*.csv

# -----------------------------------------------------------------------
# Committed data files (small, static — keep in git)
# data/schedules/*.csv       ← schedule CSVs (16 files, ~4KB each)
# data/rotowire_slate_catalog.csv  ← slate ID lookup table
# -----------------------------------------------------------------------

# -----------------------------------------------------------------------
# OS / editor noise
# -----------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# -----------------------------------------------------------------------
# Word documents
# -----------------------------------------------------------------------
.docx
*.docx
